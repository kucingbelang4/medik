# Redis (Upstash)
REDIS_URL=https://your-instance.upstash.io
REDIS_TOKEN=your_upstash_token_here

# Optional: openFDA API Key (free tier works without, but higher limits with)
OPENFDA_API_KEY=

# App URL (for absolute URLs in emails, sitemaps, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Pages (auto-injected in production)
# NODE_ENV=production